      "item": [
        {
          "name": "GET /api/catalog/cities",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json();",
                  "const riyadh = (rows || []).find(c => c.code === 'RIYADH');",
                  "if (!riyadh) return;",
                  "pm.collectionVariables.set('cityId', riyadh.id);",
                  "if (pm.environment) pm.environment.set('cityId', riyadh.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/cities",
            "description": "المدن الظاهرة. كل مدينة فيها nameAr و nameEn. يحفظ cityId للرياض."
          }
        },
        {
          "name": "GET /api/catalog/services",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json();",
                  "const hair = (rows || []).find(s => s.code === 'MS-01');",
                  "if (!hair) return;",
                  "pm.collectionVariables.set('serviceId', hair.id);",
                  "if (pm.environment) pm.environment.set('serviceId', hair.id);",
                  "if (hair.subServices && hair.subServices[0]) {",
                  "  pm.collectionVariables.set('subServiceId', hair.subServices[0].id);",
                  "  if (pm.environment) pm.environment.set('subServiceId', hair.subServices[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/services",
            "description": "الخدمات الرئيسية والفرعية (nameAr / nameEn). يحفظ serviceId و subServiceId للشعر."
          }
        },
        {
          "name": "GET /api/catalog/packages",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/packages",
            "description": "FREE / GREEN / BRONZE / SILVER / GOLD مع nameAr و nameEn."
          }
        }
