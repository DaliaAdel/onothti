        {
          "name": "POST /api/auth/login — سارة (باحثة)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (!json.accessToken) return;",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('customerToken', json.accessToken);",
                  "if (pm.environment) {",
                  "  pm.environment.set('accessToken', json.accessToken);",
                  "  pm.environment.set('customerToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"0504444444\",\n  \"password\": \"Secret123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "يحفظ customerToken. شغّليه قبل طلبات الباحثة والتقييم."
          }
        },
        {
          "name": "POST /api/auth/login — نورة (صانعة)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (!json.accessToken) return;",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('providerToken', json.accessToken);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('providerId', json.user.id);",
                  "if (pm.environment) {",
                  "  pm.environment.set('accessToken', json.accessToken);",
                  "  pm.environment.set('providerToken', json.accessToken);",
                  "  if (json.user && json.user.id) pm.environment.set('providerId', json.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
