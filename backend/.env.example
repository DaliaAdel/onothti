NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=OnothitiDB
MYSQL_SSL=false
DATABASE_URL="mysql://root@localhost:3306/OnothitiDB"

JWT_SECRET=change-this-onothiti-dev-secret
JWT_EXPIRES_IN=7d
OTP_PEPPER=change-this-otp-pepper
OTP_DEV_CODE=123456
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=3
OTP_LOCK_MINUTES=30
SETUP_SECRET=change-this-setup-secret

# --- Hostinger ---
# NODE_ENV=production
# PUBLIC_URL=https://onotht.dalia-adel.com
# FRONTEND_URL=https://webonothti.dalia-adel.com
